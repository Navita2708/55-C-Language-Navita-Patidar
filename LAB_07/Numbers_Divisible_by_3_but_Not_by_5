#include <stdio.h>

int main()
{
    int n, i, count = 0;
    
    printf("Navita Patidar\n");

    printf("Enter a number: ");
    scanf("%d", &n);

    printf("Numbers are: ");

    for(i = 1; i <= n; i++)
    {
        if(i % 3 == 0 && i % 5 != 0)
        {
            printf("%d ", i);
            count++;
        }
    }

    printf("\nTotal count = %d", count);

    return 0;
}

