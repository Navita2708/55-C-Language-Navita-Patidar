#include<stdio.h>
int main()
{
    int n;
    int i;
    printf("Navita Patidar\n");
    
    printf("Enter the value of n: ");
    scanf("%d", &n);

    printf("Numbers divisible by 3 are: ");

    for(i = 1; i <= n; i++)
    {
        if(i % 3 == 0)
        {
            printf("%d ", i);
        }
    }

    return 0;
}
