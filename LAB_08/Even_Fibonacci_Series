#include <stdio.h>

int main()
{
    printf("Navita Patidar\n");
    int a = 0, b = 1, c, n, i;

    printf("Enter the number of terms: ");
    scanf("%d", &n);

    printf("Even Fibonacci series: ");

    for(i = 1; i <= n; i++)
    {
        if(a % 2 == 0)
        {
            printf("%d ", a);
        }

        c = a + b;
        a = b;
        b = c;
    }

    return 0;
}
